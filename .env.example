# PostgreSQL
POSTGRES_USER=editorial
POSTGRES_PASSWORD=editorial
POSTGRES_DB=editorial
DATABASE_URL=postgresql+psycopg://editorial:editorial@db:5432/editorial

# Backend
ENVIRONMENT=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# AI
# Without a key the draft endpoint runs in demo mode (offline mock draft).
# Set a real key (https://console.anthropic.com/) for live generation:
ANTHROPIC_API_KEY=

# Bible text for the translation comparison sidebar.
# Without a key the sidebar shows public-domain KJV/WEB demo data.
# Set a free key (https://scripture.api.bible/setup) for ESV/NIV/KJV/NASB/NLT:
BIBLE_API_KEY=
BIBLE_TRANSLATIONS=ESV,NIV,KJV,NASB,NLT

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
